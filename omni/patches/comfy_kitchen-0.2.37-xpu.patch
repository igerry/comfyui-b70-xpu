+
+        @_compiled_int8_linear.register_fake
+        def _compiled_int8_linear_fake(
+            x,
+            weight,
+            weight_scale,
+            bias,
+            output_dtype_code,
+            convrot,
+            convrot_groupsize,
+            input_act_code,
+        ):
