+                    x,
+                    weight,
+                    weight_scale,
+                    bias,
+                    out_dtype,
+                    convrot,
+                    convrot_groupsize,
+                    input_act,
+                )
+
+            actual_dtype = x.dtype if out_dtype is None else out_dtype
+            output_dtype_code = {
+                torch.float32: 0,
+                torch.float16: 1,
+                torch.bfloat16: 2,
