+            except ValueError as exc:
+                raise ValueError(f"Unsupported input_act: {input_act!r}") from exc
+            return _compiled_int8_linear(
+                x,
+                weight,
+                weight_scale,
+                bias,
+                output_dtype_code,
+                convrot,
+                convrot_groupsize,
+                input_act_code,
