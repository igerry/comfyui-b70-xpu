+            )
+
+        def _int8_linear_core(
+            x: torch.Tensor,
+            weight: torch.Tensor,
+            weight_scale: torch.Tensor,
+            bias: torch.Tensor | None = None,
+            out_dtype: torch.dtype | None = None,
+            convrot: bool = False,
+            convrot_groupsize: int = 256,
+            input_act: str | None = None,
