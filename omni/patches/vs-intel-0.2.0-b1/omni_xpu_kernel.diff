+torch::Tensor rms_norm_mod(
+    torch::Tensor weight,
+    torch::Tensor input,
+    torch::Tensor scale,
+    torch::Tensor shift,
+    torch::Tensor seg_end,
+    torch::Tensor seg_mod,
+    double eps
